datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id        String   @id @default(cuid())
  code      String   @unique // e.g., 1000-6000 standard numbering
  name      String
  type      String   // Asset, Liability, Equity, Income, Expense
  currency  String   @default("USD")
  balance   Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id         String   @id @default(cuid())
  macolaCode String?  @unique // Macola tracking code
  name       String
  email      String?
  phone      String?
  address    String?
  currency   String   @default("USD")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Vendor {
  id         String   @id @default(cuid())
  macolaCode String?  @unique // Macola tracking code
  name       String
  email      String?
  phone      String?
  address    String?
  currency   String   @default("USD")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model InventoryItem {
  id          String   @id @default(cuid())
  sku         String   @unique
  description String
  quantity    Float    @default(0)
  cost        Float    @default(0)
  price       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanySettings {
  id               String   @id @default("default")
  nombre           String   @default("WAYNE TRADEMARK PRINTING AND PACKAGING DE HONDURAS S DE RL")
  direccion        String   @default("ZIP Búfalo, Villanueva, Cortés 21100")
  email            String   @default("R.mondragon@waynetrademarkhn.com")
  telefono         String   @default("+50494522666")
  sitioWeb         String   @default("Ninguno indicado")
  sector           String   @default("Manufactura y Producción Industrial (Manufacturing)")
  nombreLegal      String   @default("WAYNE TRADEMARK PRINTING AND PACKAGING DE HONDURAS S DE RL")
  taxId            String   @default("05019008183490")
  tipoEmpresa      String   @default("Sociedad anónima (pequeña empresa) con dos o más propietarios")
  domicilioLegal   String   @default("Zip Búfalo Edificio 1B, Villanueva, Cortés 21101")
  emailCliente     String   @default("R.mondragon@waynetrademarkhn.com")
  direccionCliente String   @default("Ninguno indicado")
  logoUrl          String?  @db.Text
  updatedAt        DateTime @updatedAt
}

model BankAccount {
  id            String            @id @default(cuid())
  name          String            // e.g. "Banco Ficohsa"
  accountNumber String            // e.g. "•••• 2266"
  type          String            // e.g. "Cuenta de cheques empresarial USD"
  currency      String            @default("USD")
  bankBalance   Float             @default(0)
  bookBalance   Float             @default(0)
  lastUpdated   String            @default("Hoy, 10:15 PM")
  status        String            @default("Conectado")
  color         String            @default("#0284c7")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  transactions  BankTransaction[]
}

model BankTransaction {
  id               String       @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date             String       // e.g. "02/09/2026"
  description      String
  payee            String
  type             String       // "deposit" | "expense"
  amount           Float
  suggestedAccount String
  ruleApplied      String?
  status           String       @default("porRevisar") // "porRevisar" | "categorizadas" | "excluidas"
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model BankRule {
  id            String   @id @default(cuid())
  name          String
  condition     String
  targetAccount String
  autoConfirm   Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
